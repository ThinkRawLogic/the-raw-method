#!/bin/sh
#
# pre-commit.sample — el hook de git que corre los candados en cada commit
# ========================================================================
#
# Parte de The Raw Method. Este archivo es el que convierte los candados de
# "algo que hay que acordarse de correr" en "algo que corre solo, siempre".
#
# QUÉ ES ESTO (para el dueño no-ingeniero)
# ----------------------------------------
# Git —el programa que guarda las versiones del proyecto— permite poner un
# "portero" que se ejecuta ANTES de cada guardado (cada `commit`). Este archivo
# es ese portero. Antes de dejar entrar un cambio, corre los candados. Si un
# candado falla, el portero NO ABRE LA PUERTA: el commit se cancela y el cambio
# no se guarda hasta que arregles lo que rompió.
#
# Ese es el momento exacto en que el método deja de depender de tu memoria: no
# tienes que acordarte de revisar nada, el portero lo hace por ti, cada vez, sin
# excepción, aunque sean las 3 de la mañana de un viernes.
#
# CÓMO ACTIVARLO (una sola vez)
# -----------------------------
# Elige UNA de las dos opciones.
#
#   OPCIÓN A — a mano (sin instalar nada):
#     1. Copia este archivo a la carpeta oculta de hooks de git de tu proyecto:
#            cp candados/pre-commit.sample .git/hooks/pre-commit
#     2. Dale permiso de ejecución (en Mac/Linux/Git-Bash):
#            chmod +x .git/hooks/pre-commit
#     3. Listo. Desde el próximo `git commit`, los candados corren solos.
#
#   OPCIÓN B — con husky (recomendado si el equipo comparte el repo):
#     husky mete los hooks DENTRO del repo, así todos los que clonan el proyecto
#     los reciben (con la opción A, cada persona tiene que copiarlos a mano).
#     1. npm install -D husky
#     2. npx husky init
#     3. Pega la línea de "LO QUE CORRE" (de abajo) dentro de .husky/pre-commit
#
# NOTA: la Opción A vive solo en tu máquina (la carpeta .git no se comparte). Para
# un proyecto en equipo, la Opción B es la que garantiza que TODOS tengan el portero.
#
# ---------------------------------------------------------------------------
# GUARD DE RAMA — sólo para repos con MÁS DE UNA PERSONA (opt-in)
# ---------------------------------------------------------------------------
# Duerme salvo que exista el archivo `.raw-rama-obligatoria` en la raíz del repo.
# Es deliberado: a alguien que trabaja SOLO, bloquearle `main` es fricción y no
# protección — y una regla que estorba se arranca, y arrancada no protege a nadie.
#
# Encendelo cuando el repo tenga dos committers:   touch .raw-rama-obligatoria
#
# QUÉ RESUELVE. Con una sola persona, commitear en `main` no molesta. Con dos,
# `main` compartida es el punto de choque: el primero sube, el segundo rebota. En
# una rama propia eso no puede pasar, y el respaldo automático (post-commit.sample)
# vuelve a ser lo que fue diseñado — respalda LO TUYO, sin chocar con nadie.
#
# Va PRIMERO, antes de los candados: enterarte de que estabas en `main` DESPUÉS de
# esperar la suite entera es un castigo, no un aviso. Esto falla en milisegundos.
RAIZ="$(git rev-parse --show-toplevel 2>/dev/null)"
if [ -n "$RAIZ" ] && [ -f "$RAIZ/.raw-rama-obligatoria" ]; then
  # `symbolic-ref` y NO `rev-parse --abbrev-ref`: este último necesita que HEAD apunte
  # a un commit existente, así que en una rama todavía SIN commits devuelve error en
  # vez del nombre — y el guard se abría solo. Fallar ABIERTO es el peor modo; lo cazó
  # la prueba del repo recién creado, no el razonamiento.
  RAMA="$(git symbolic-ref --short HEAD 2>/dev/null)"
  GIT_DIR_="$(git rev-parse --git-dir)"

  # Una fusión, un cherry-pick, un revert o un rebase EN CURSO commitean sobre la rama
  # protegida de forma LEGÍTIMA: así aterriza un PR, y `git pull --rebase` es justo lo
  # que el post-commit manda a hacer cuando la rama divergió. Bloquearlos convertiría
  # el guard en un callejón sin salida.
  if [ -f "$GIT_DIR_/MERGE_HEAD" ] || [ -f "$GIT_DIR_/CHERRY_PICK_HEAD" ] || [ -f "$GIT_DIR_/REVERT_HEAD" ] || [ -d "$GIT_DIR_/rebase-merge" ] || [ -d "$GIT_DIR_/rebase-apply" ]; then
    EN_OPERACION=1
  else
    EN_OPERACION=0
  fi

  if { [ "$RAMA" = "main" ] || [ "$RAMA" = "master" ]; } && [ "$EN_OPERACION" -eq 0 ] && [ -z "$COMMIT_EN_MAIN" ]; then
    echo ""
    echo "🚫 Estás por commitear en '$RAMA'. Acá se trabaja en RAMA."
    echo ""
    echo "   Con más de una persona, la rama compartida es el punto de choque: el"
    echo "   primero en subir gana y el segundo rebota. En tu propia rama no pasa."
    echo ""
    echo "   👉 Llevate a una rama nueva lo que ya tenés armado (no perdés nada):"
    echo "        git switch -c mejora/lo-que-estas-haciendo"
    echo "        git commit ..."
    echo ""
    echo "   Y cuando esté listo:  git push -u origin <rama>  →  PR  →  decide el CI."
    echo ""
    echo "   Si de verdad va en '$RAMA' (sesión en solitario, arreglo urgente), decilo a propósito:"
    echo "        COMMIT_EN_MAIN=1 git commit ..."
    echo ""
    exit 1
  fi
fi

# ---------------------------------------------------------------------------
# LO QUE CORRE
# ---------------------------------------------------------------------------

echo "The Raw Method · corriendo los candados antes de guardar..."

# Corre SOLO los candados de conformidad (rápido, para no demorar cada commit).
# Con vitest en el stack de referencia:
npx vitest run candados/conformance.test.ts
RESULTADO=$?

# Si además tienes candados propios en otros archivos, agrega acá sus corridas,
# o corre toda la suite de candados de una:
#     npx vitest run candados/
# (más lento pero más completo — elige según cuánto tarde tu suite).

if [ $RESULTADO -ne 0 ]; then
  echo ""
  echo "  ✗ Un candado falló. El commit se canceló."
  echo "    Arregla lo que reportó el candado de arriba y vuelve a intentar."
  echo "    (Esto NO es un castigo: es el portero atajando un error donde todavía es gratis.)"
  echo ""
  exit 1   # exit distinto de 0 = git cancela el commit
fi

echo "  ✓ Candados en verde. Guardando."
exit 0     # exit 0 = git deja pasar el commit
